{
  "name": "@saifymatteo/pi-cell-actions",
  "version": "0.1.1",
  "license": "AGPL-3.0-only",
  "description": "Hover a transcript cell for a ⋯ menu: copy messages, code, tables (Markdown/TSV/CSV) and tool calls; run shell blocks",
  "engines": {
    "node": ">=24"
  },
  "pi": {
    "image": "https://raw.githubusercontent.com/saifymatteo/pi-extensions/main/packages/pi-cell-actions/screenshot.png",
    "extensions": [
      "./src/index.ts"
    ]
  },
  "files": [
    "src",
    "README.md",
    "CHANGELOG.md",
    "NOTICE.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "keywords": [
    "pi-package",
    "pi-extension"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/saifymatteo/pi-extensions.git",
    "directory": "packages/pi-cell-actions"
  }
}
