{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true,
    "strict": false,
    "resolveJsonModule": true
  },
  "include": ["packages/*/src/**/*.ts", "collection/gate.ts", "collection/pi-extensions.ts"],
  "exclude": ["packages/pi-agent-ask/**", "packages/pi-atelier/**", "packages/pi-x-ide/**"]
}