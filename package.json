{
	"name": "@saifymatteo/pi-extensions",
	"version": "0.1.30",
	"type": "module",
	"license": "AGPL-3.0-only",
	"description": "Independently installable Pi extensions",
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"check": "node scripts/check-packages.mjs",
		"typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.agent-ask.json && tsc -p tsconfig.atelier.json && tsc -p tsconfig.x-ide.json",
		"test": "node --test test/*.test.mjs packages/*/test/*.test.mjs && npm test -w packages/pi-orchestrator -w packages/pi-agent-ask -w packages/pi-atelier -w packages/pi-x-ide",
		"pack:check": "node scripts/check-pack.mjs",
		"dev": "node scripts/dev.mjs",
		"smoke": "node scripts/smoke.mjs",
		"context": "node scripts/context-audit.mjs",
		"screenshots": "node scripts/screenshots/shots.mjs",
		"demo": "node scripts/screenshots/demo.mjs"
	},
	"dependencies": {
		"jsonc-parser": "^3.3.1"
	},
	"devDependencies": {
		"@earendil-works/pi-coding-agent": "1.6.1",
		"@earendil-works/pi-ai": "^1.6.1",
		"@earendil-works/pi-tui": "1.6.1",
		"@types/node": "24.19.2",
		"typebox": "^1.0.0",
		"typescript": "~5.9.3"
	},
	"engines": {
		"node": ">=24"
	},
	"pi": {
		"image": "https://raw.githubusercontent.com/saifymatteo/pi-extensions/main/demo.gif",
		"extensions": [
			"./collection/pi-load-pi-dotenv.ts",
			"./collection/pi-9router.ts",
			"./collection/pi-agent-ask.ts",
			"./collection/pi-atelier.ts",
			"./collection/pi-bg-bash.ts",
			"./collection/pi-cell-actions.ts",
			"./collection/pi-claude-usage.ts",
			"./collection/pi-clipboard-image.ts",
			"./collection/pi-codeblock-borders.ts",
			"./collection/pi-codegraph.ts",
			"./collection/pi-compact-tools.ts",
			"./collection/pi-decisions.ts",
			"./collection/pi-draft.ts",
			"./collection/pi-model-go.ts",
			"./collection/pi-orchestrator.ts",
			"./collection/pi-prestart-working.ts",
			"./collection/pi-root-guard.ts",
			"./collection/pi-session-finder.ts",
			"./collection/pi-session-id.ts",
			"./collection/pi-session-nav.ts",
			"./collection/pi-session-rename.ts",
			"./collection/pi-session-retention.ts",
			"./collection/pi-skill-usage-log.ts",
			"./collection/pi-tool-usage-log.ts",
			"./collection/pi-tts.ts",
			"./collection/pi-user-image-previews.ts",
			"./collection/pi-vision.ts",
			"./collection/pi-wait.ts",
			"./collection/pi-x-ide.ts",
			"./collection/pi-zvec.ts",
			"./collection/pi-extensions.ts"
		],
		"skills": [
			"./packages/pi-vision/skills"
		]
	},
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/saifymatteo/pi-extensions.git"
	},
	"keywords": [
		"pi-package",
		"pi-extension",
		"pi-skill"
	],
	"files": [
		"packages",
		"!packages/*/screenshot.png",
		"collection",
		"schemas",
		"inventory.json",
		"README.md",
		"CHANGELOG.md",
		"NOTICE.md",
		"LICENSE"
	]
}
